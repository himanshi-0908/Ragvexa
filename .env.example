NVIDIA_API_KEY=nvapi-your-key-here

# Generate each with: python -c "import secrets; print(secrets.token_hex(32))"
COOKIE_SECRET=
JWT_SECRET=

COOKIE_NAME=ragvexa_auth
COOKIE_EXPIRY_DAYS=7
JWT_EXPIRE_MINUTES=1440

# Storage
DATABASE_URL=sqlite:///./copilot.db
CHROMA_DB_DIR=./chroma_db
UPLOAD_DIR=./private_uploads

# Upload / usage limits
MAX_UPLOAD_SIZE_MB=10
MAX_DOCS_PER_USER=25
MAX_CHUNKS_PER_USER=5000
MAX_QUERIES_PER_DAY=200
MAX_BENCHMARKS_PER_DAY=20
MAX_URL_FETCH_BYTES=5242880

# Models (NVIDIA NIM ids). Judge should differ from the answer model.
# Check which ids your key can use:  python scripts/check_models.py --probe
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
EVAL_GENERATOR_MODELS=nvidia/nemotron-3-ultra-550b-a55b,nvidia/nemotron-3.5-lightning-30b-a3b
JUDGE_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Optional: USD per 1M tokens, used only for cost estimates. Leave empty to
# report cost as unavailable instead of guessing.
# MODEL_PRICES_JSON={"nvidia/nemotron-3-ultra-550b-a55b": {"input": 0.0, "output": 0.0}}

# FastAPI only
ALLOWED_ORIGINS=http://localhost:8501
ENV=development
